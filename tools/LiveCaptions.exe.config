<?xml version="1.0" encoding="utf-8"?>
<!--
  Va junto a LiveCaptions.exe (lo copia tools/build.py).

  Un zip descargado de Internet lleva la marca "Mark of the Web", y el Explorador la pasa a
  cada archivo al extraerlo. .NET Framework se niega a cargar ensamblados con esa marca, y
  pythonnet (con el que pywebview abre la ventana) fallaba al arrancar con
  "Failed to resolve Python.Runtime.Loader.Initialize". Esto le dice que los cargue igual.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
